{
  "ci": {
    "collect": {
      "staticDistDir": "_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/projects/index.html",
        "http://localhost/cv/index.html",
        "http://localhost/certificates/index.html",
        "http://localhost/lab/index.html",
        "http://localhost/links/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/impressum/index.html",
        "http://localhost/impressum/social/index.html",
        "http://localhost/datenschutz/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["error", { "minScore": 0.95 }],
        "categories:accessibility":  ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo":            ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}

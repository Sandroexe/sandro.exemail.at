---
layout: null
sitemap: false
---
{%- assign p = site.data.person -%}
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ p.vorname | jsonify }},
  "description": {{ site.description | strip | jsonify }},
  "lang": {{ site.lang | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "display": "browser",
  "icons": [
    { "src": "{{ '/assets/img/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
